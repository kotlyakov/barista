extends SceneTree
func touch(node,point: Vector2) -> void:
 var event=InputEventScreenTouch.new()
 event.index=0;event.position=point;event.pressed=true;node._input(event)
 event.pressed=false;node._input(event)
func _init() -> void:
 call_deferred("run")
func run() -> void:
 var node=load("res://ui/main.tscn").instantiate()
 var path="user://cafe-shell-"+str(Time.get_ticks_usec())
 node.save_directory=path
 root.add_child(node)
 node.set_process(false)
 assert(node.screen=="intro","career must open directly into the cafe intro")
 var before=node.game.snapshot()
 node._notification(Control.NOTIFICATION_APPLICATION_FOCUS_OUT)
 node._process(5)
 assert(node.intro_elapsed==0,"background must freeze intro too")
 node._notification(Control.NOTIFICATION_APPLICATION_FOCUS_IN)
 node._process(2.999)
 assert(node.screen=="intro" and node.game.data.clock==before.clock)
 node._process(.001)
 assert(node.screen=="" and node.game.data.clock==before.clock)
 node.act("choose_perk",[node.game.shift.data.offers[0]])
 node.act("start_shift")
 node.sync_guest(true)
 touch(node,Vector2(1490,60))
 assert(node.screen=="menu" and node.paused)
 assert(not node.audio.active,"menu must suspend audio")
 before=node.game.snapshot()
 node._process(4)
 touch(node,node.station_rects[0].get_center())
 assert(node.game.snapshot()==before,"menu must freeze all domain state")
 touch(node,Vector2(800,625))
 assert(node.screen=="progress" and node.paused)
 node._process(3)
 assert(node.game.snapshot()==before,"progress must not advance orders")
 touch(node,Vector2(200,60))
 assert(node.screen=="menu")
 touch(node,Vector2(800,525))
 assert(node.repository.preferences().muted)
 assert(node.audio.muted)
 var repo=load("res://persistence/repository.gd").new(path)
 assert(repo.preferences().muted,"mute must survive restart")
 touch(node,Vector2(800,425))
 assert(node.screen=="" and not node.paused)
 assert(node.audio.active and node.audio.muted)
 node._process(.1)
 assert(node.game.data.clock>before.clock)
 node._notification(Control.NOTIFICATION_APPLICATION_FOCUS_OUT)
 assert(node.paused and node.screen=="menu")
 var node2=load("res://ui/main.tscn").instantiate()
 node2.save_directory=path
 root.add_child(node2)
 node2.set_process(false)
 var taps=node2.game.brew.taps.duplicate()
 touch(node2,node2.station_rects[0].get_center())
 assert(node2.screen=="" and node2.game.brew.taps==taps,"intro skip must consume station touch")
 assert(node2.game.data.clock==node.game.data.clock,"restart restores active time")
 node2.game.shift.data.mode="FINISHED"
 node2.game.data.order.state="CLOSED"
 node2.repository.checkpoint()
 var career=node2.game.snapshot()
 touch(node2,Vector2(800,800))
 assert(node2.repository.training,"finished shift must offer training on the same scene")
 node2.game.data.money=9999
 touch(node2,Vector2(1300,830))
 assert(not node2.repository.training and node2.game.snapshot()==career,"leaving training restores career")
 node.queue_free();node2.queue_free()
 await process_frame
 print("PASS: cafe intro, skip consumption, menu/progress pause, durable mute and restart")
 quit()
