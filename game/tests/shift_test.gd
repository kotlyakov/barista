extends SceneTree
func _init() -> void:
 var script=load("res://shift/shift.gd")
 if script==null:
  push_error("FAIL: daily shift state machine missing")
  quit(1)
  return
 var before=Time.get_unix_time_from_datetime_string("2026-12-31T07:59:59")
 var at=before+1
 var shift=script.new(before,0)
 assert(shift.data.day_key=="2026-12-30")
 assert(shift.data.mode=="SHOP" and not shift.advance(1,at,false).is_empty())
 assert(shift.data.day_key=="2026-12-31")
 shift.select_perk(shift.data.offers[0])
 assert(shift.start())
 shift.advance(479,at,false)
 assert(shift.data.remaining==1)
 shift.advance(100,at,true)
 assert(shift.data.remaining==1,"background frozen")
 var close=shift.advance(1,at,false,true)
 assert(close.action=="close_started" and shift.data.mode=="CLOSING")
 assert(not shift.start())
 shift.finish(10,8)
 assert(shift.data.success and shift.collect_reward()==200 and shift.collect_reward()==0)
 assert(shift.refresh(before).is_empty(),"clock rollback cannot open an old day")
 var next_day=Time.get_unix_time_from_datetime_string("2027-01-03T10:00:00")
 shift.refresh(next_day)
 assert(shift.data.day_key=="2027-01-03" and shift.data.mode=="SHOP")
 var zone=script.new(Time.get_unix_time_from_datetime_string("2026-10-29T05:00:00"),180)
 assert(zone.data.day_key=="2026-10-29","fixed profile offset +03:00 reaches 08:00")
 var pending=script.new(before,0)
 pending.select_perk(pending.data.offers[0])
 pending.start()
 pending.advance(0,at,false,true)
 assert(pending.data.day_key=="2026-12-30" and pending.data.mode=="CLOSING","old shift settles before new day")
 print("PASS: 08:00, year rollover, skipped days, rollback, active timer, closing, single reward")
 quit(0)
